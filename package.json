{
  "name": "coder-studio",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "tsx scripts/dev-web.ts",
    "dev:server": "tsx scripts/dev-server.ts",
    "dev:desktop": "tsx scripts/dev-desktop.ts",
    "build": "tsx scripts/build.ts",
    "build:web": "tsx scripts/build-web.ts",
    "build:web:ui-preview": "pnpm --filter @coder-studio/web run build:ui-preview",
    "build:cli": "tsx scripts/build-cli.ts",
    "build:desktop": "tsx scripts/build-desktop.ts",
    "build:desktop-runtime": "tsx scripts/build-desktop-runtime.ts",
    "build:wsl-runtime": "tsx scripts/build-wsl-runtime.ts",
    "build:wsl-engine": "tsx scripts/build-wsl-engine.ts",
    "prepare:desktop": "tsx scripts/prepare-desktop-package.ts",
    "pack:desktop": "pnpm build:desktop && pnpm prepare:desktop && pnpm --filter @coder-studio/desktop run pack",
    "dist:desktop": "pnpm build:desktop && pnpm prepare:desktop && pnpm --filter @coder-studio/desktop run dist",
    "smoke:desktop": "tsx scripts/smoke-desktop-package.ts",
    "release:channel": "tsx scripts/build-desktop-channel.ts",
    "release:artifacts": "tsx scripts/desktop-release-artifacts.ts",
    "changeset": "changeset",
    "changeset:validate": "tsx scripts/validate-changesets.ts",
    "version-packages": "changeset version",
    "publish:cli": "tsx scripts/publish-cli.ts",
    "validate:cli-package": "tsx scripts/validate-cli-package.ts",
    "publish:wiki": "tsx scripts/publish-wiki.ts",
    "ci:lint": "pnpm exec biome check --diagnostic-level=error --max-diagnostics=none .",
    "ci:test:scripts": "pnpm exec vitest run --config scripts/vitest.config.ts --environment node",
    "ci:test:workspace": "pnpm -r --filter './packages/**' --filter '!@coder-studio/web' --if-present run test && pnpm --filter @coder-studio/web test",
    "ci:test": "pnpm ci:test:scripts && pnpm ci:test:workspace",
    "ci:typecheck:strict": "pnpm --filter @spencer-kit/coder-studio exec tsc -p tsconfig.json --noEmit && pnpm --filter @coder-studio/utils exec tsc -p tsconfig.json --noEmit && pnpm --filter @coder-studio/core exec tsc -p tsconfig.json --noEmit && pnpm --filter @coder-studio/providers exec tsc -p tsconfig.json --noEmit && pnpm --filter @coder-studio/server exec tsc -p tsconfig.json --noEmit && pnpm --filter @coder-studio/desktop typecheck",
    "ci:typecheck:web": "tsx scripts/check-typecheck-baseline.ts",
    "ci:typecheck": "pnpm ci:typecheck:strict && pnpm ci:typecheck:web",
    "ci:build": "pnpm --filter @coder-studio/server build && pnpm build",
    "ci:verify": "pnpm changeset:validate && pnpm ci:lint && pnpm ci:typecheck && pnpm ci:test && pnpm ci:build",
    "ci:release:validate": "pnpm ci:verify && pnpm publish:cli -- --no-build",
    "acceptance:phase1": "pnpm --dir e2e exec playwright test --config playwright.config.ts --grep @phase1",
    "acceptance:phase1:update-baseline": "pnpm --dir e2e exec playwright test --config playwright.config.ts --grep @phase1 --update-snapshots",
    "acceptance:phase1:report": "node e2e/fixtures/report-writer.ts phase-1",
    "acceptance:wsl:prepare": "tsx scripts/prepare-wsl-acceptance.ts",
    "acceptance:runtime:update": "tsx scripts/prepare-wsl-acceptance.ts --runtime-only",
    "acceptance:runtime:verify": "tsx scripts/verify-desktop-runtime-update.ts",
    "acceptance:cli:update": "tsx scripts/verify-cli-update.ts",
    "acceptance:desktop:installed": "pwsh -NoProfile -File scripts/verify-desktop-installed-update.ps1",
    "acceptance:wsl:serve": "tsx scripts/serve-wsl-acceptance.ts",
    "e2e-ui": "tsx scripts/e2e-ui.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@coder-studio/utils": "workspace:*",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "tar": "^7.5.22",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "yaml": "^2.8.1"
  }
}
