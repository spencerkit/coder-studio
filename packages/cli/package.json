{
  "name": "@coder-studio/cli",
  "version": "0.0.1",
  "type": "module",
  "description": "Coder Studio CLI - The only published package",
  "bin": {
    "coder-studio": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../../../src/scripts/build-cli.ts",
    "dev": "tsx ../../../src/scripts/dev-server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@coder-studio/core": "workspace:*",
    "@coder-studio/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "cli",
    "coder-studio",
    "agent",
    "development",
    "tools"
  ],
  "author": "",
  "license": "MIT"
}
