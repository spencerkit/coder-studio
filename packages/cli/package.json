{
  "name": "@spencer-kit/coder-studio",
  "version": "0.0.1",
  "type": "module",
  "description": "Coder Studio CLI - The only published package",
  "bin": {
    "coder-studio": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "types": "./dist/esm/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-cli.ts",
    "dev": "tsx ../../scripts/dev-server.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "fastify": "^5.8.5",
    "ignore": "^7.0.5",
    "node-pty": "^1.1.0",
    "pino-pretty": "^13.1.3",
    "pm2": "^6.0.14",
    "uuid": "^14.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "cli",
    "coder-studio",
    "agent",
    "development",
    "tools"
  ],
  "author": "Coder Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/coder-studio.git"
  },
  "bugs": {
    "url": "https://github.com/anthropics/coder-studio/issues"
  },
  "homepage": "https://github.com/anthropics/coder-studio#readme"
}
